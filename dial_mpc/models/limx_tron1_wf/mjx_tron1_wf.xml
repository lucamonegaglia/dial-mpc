<mujoco model="limx_tron1_wf">
    <compiler angle="radian" meshdir="meshes" autolimits="true" />

    <option iterations="1" ls_iterations="1" timestep="0.02" gravity="0.0 0.0 -9.81">
        <flag eulerdamp="disable" />
    </option>

    <default>
        <default class="tron1">
            <joint armature="0.01" damping="0.01" />
            <geom margin="0.001" condim="1" friction="0.6" />
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2" />
            </default>
            <!-- leg-link collision is disabled (contype/conaffinity 0): only the base box and the
                 two wheels touch the floor. Each cylinder wheel yields 2 floor contacts, so the
                 standing robot sits at 4. -->
            <default class="leg_collision">
                <geom group="3" contype="0" conaffinity="0" rgba="0 0 1 0" />
            </default>
            <default class="collision">
                <geom group="3" contype="0" conaffinity="1" />
                <default class="wheel">
                    <!-- Upstream cylinder (r=0.127, half-height 0.005), quat rotating its local z
                         onto the hinge (y) axis. MJX supports PLANE x CYLINDER; this costs more
                         contacts than a sphere but gives a true disc edge and a real contact patch
                         rather than a point. Visual stays a mesh. -->
                    <geom type="cylinder" size="0.127 0.005" quat="0.707107 0.707107 0 0"
                        solimp="0.015 1 0.031"
                        friction="0.6 0.02 0.01" condim="3" rgba="1 0.423529 0.0392157 0.4" />
                </default>
            </default>
        </default>
    </default>

    <asset>
        <mesh name="base_Link" file="base_Link.STL" />
        <mesh name="abad_L_Link" file="abad_L_Link.STL" />
        <mesh name="hip_L_Link" file="hip_L_Link.STL" />
        <mesh name="knee_L_Link" file="knee_L_Link.STL" />
        <mesh name="wheel_L_Link" file="wheel_L_Link.STL" />
        <mesh name="abad_R_Link" file="abad_R_Link.STL" />
        <mesh name="hip_R_Link" file="hip_R_Link.STL" />
        <mesh name="knee_R_Link" file="knee_R_Link.STL" />
        <mesh name="wheel_R_Link" file="wheel_R_Link.STL" />
    </asset>

    <worldbody>
        <body name="base_Link" pos="0 0 0.72" childclass="tron1">
            <inertial pos="0.0457123 0.000139854 -0.163809"
                quat="0.972578 -0.00615364 -0.232461 0.00398682" mass="9.595"
                diaginertia="0.154712 0.11093 0.0846371" />
            <freejoint />
            <site name="imu" pos="0 0 0" />
            <camera name="track" mode="trackcom" pos="0 -2.3 0.9" xyaxes="1 0 0 0 0.707 0.707" />
            <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="base_Link" />
            <geom name="base_collision" class="collision" size="0.135 0.13 0.095" pos="0.03 0 -0.072"
                type="box" rgba="0 0 1 0" />

            <body name="abad_L_Link" pos="0.05556 0.105 -0.2602">
                <inertial pos="-0.06977 0.04479 0.00057"
                    quat="0.595024 0.579772 0.394141 0.393019" mass="1.469"
                    diaginertia="0.00252289 0.00208104 0.00139163" />
                <joint name="abad_L_Joint" axis="1 0 0" range="-0.38397 1.39626" />
                <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="abad_L_Link" />
                <geom name="abad_L_collision" class="leg_collision" type="cylinder" pos="-0.08 0 0"
                    euler="1.57 0 0" size="0.05 0.025" />

                <body name="hip_L_Link" pos="-0.077 0.0205 0">
                    <inertial pos="-0.02869 -0.0477 -0.03992"
                        quat="0.853885 0.192797 0.226903 0.426877" mass="2.3"
                        diaginertia="0.0233264 0.0230229 0.00277548" />
                    <joint name="hip_L_Joint" axis="0 1 0" range="-1.01229 1.39626" />
                    <geom class="visual" rgba="1 1 1 1" mesh="hip_L_Link" />
                    <geom name="hip_L_collision" class="leg_collision" type="cylinder"
                        pos="-0.1 -0.025 -0.14" euler="0 0.53 0" size="0.035 0.075" />

                    <body name="knee_L_Link" pos="-0.15 -0.0205 -0.25981">
                        <inertial pos="0.11913 0.01106 -0.20363"
                            quat="0.687012 -0.159981 -0.201582 0.679548" mass="1.49"
                            diaginertia="0.0177107 0.0171855 0.001015" />
                        <joint name="knee_L_Joint" axis="0 -1 0" range="-0.872665 1.36136" />
                        <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="knee_L_Link" />
                        <geom name="knee_L_collision" class="leg_collision" type="cylinder"
                            pos="0.078 0 -0.12" euler="0 -0.55 0" size="0.015 0.13" />

                        <body name="wheel_L_Link" pos="0.15 0.0435 -0.25981">
                            <inertial pos="3e-05 0.00807 -2e-05"
                                quat="0.683013 0.183016 0.183017 0.683011" mass="1.08"
                                diaginertia="0.00974272 0.00515568 0.00515344" />
                            <joint name="wheel_L_Joint" axis="0 1 0" limited="false"
                                frictionloss="0.01" />
                            <geom class="visual" rgba="0.26667 0.26667 0.26667 1"
                                mesh="wheel_L_Link" />
                            <site name="wheel_L" pos="0.0 0.008 0.0" group="1" />
                            <geom name="wheel_L_collision" class="wheel" pos="0.0 0.008 0.0" />
                        </body>
                    </body>
                </body>
            </body>

            <body name="abad_R_Link" pos="0.05556 -0.105 -0.2602">
                <inertial pos="-0.06977 -0.04479 0.00057"
                    quat="0.393019 0.394141 0.579772 0.595024" mass="1.469"
                    diaginertia="0.00252289 0.00208104 0.00139163" />
                <joint name="abad_R_Joint" axis="1 0 0" range="-1.39626 0.38397" />
                <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="abad_R_Link" />
                <geom name="abad_R_collision" class="leg_collision" type="cylinder" pos="-0.08 0 0"
                    euler="1.57 0 0" size="0.05 0.025" />

                <body name="hip_R_Link" pos="-0.077 -0.0205 0">
                    <inertial pos="-0.02869 0.0477 -0.03992"
                        quat="0.426877 0.226903 0.192797 0.853885" mass="2.3"
                        diaginertia="0.0233264 0.0230229 0.00277548" />
                    <joint name="hip_R_Joint" axis="0 -1 0" range="-1.39626 1.01229" />
                    <geom class="visual" rgba="1 1 1 1" mesh="hip_R_Link" />
                    <geom name="hip_R_collision" class="leg_collision" type="cylinder"
                        pos="-0.10 0.025 -0.14" euler="0 0.53 0" size="0.035 0.075" />

                    <body name="knee_R_Link" pos="-0.15 0.0205 -0.25981">
                        <inertial pos="0.11913 -0.01106 -0.20363"
                            quat="0.679548 -0.201582 -0.159981 0.687012" mass="1.49"
                            diaginertia="0.0177107 0.0171855 0.001015" />
                        <joint name="knee_R_Joint" axis="0 1 0" range="-1.36136 0.872665" />
                        <geom class="visual" rgba="0.79216 0.81961 0.93333 1" mesh="knee_R_Link" />
                        <geom name="knee_R_collision" class="leg_collision" type="cylinder"
                            pos="0.078 0 -0.12" euler="0 -0.55 0" size="0.015 0.13" />

                        <body name="wheel_R_Link" pos="0.15 -0.0435 -0.25981">
                            <inertial pos="3e-05 -0.00807 -2e-05"
                                quat="0.683011 0.183017 0.183016 0.683013" mass="1.08"
                                diaginertia="0.00974272 0.00515568 0.00515344" />
                            <joint name="wheel_R_Joint" axis="0 1 0" limited="false"
                                frictionloss="0.01" />
                            <geom class="visual" rgba="0.26667 0.26667 0.26667 1"
                                mesh="wheel_R_Link" />
                            <site name="wheel_R" pos="0.0 -0.008 0.0" group="1" />
                            <geom name="wheel_R_collision" class="wheel" pos="0.0 -0.008 0.0" />
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="abad_L_Joint" gear="1" joint="abad_L_Joint" ctrlrange="-80 80" />
        <motor name="hip_L_Joint" gear="1" joint="hip_L_Joint" ctrlrange="-80 80" />
        <motor name="knee_L_Joint" gear="1" joint="knee_L_Joint" ctrlrange="-80 80" />
        <motor name="wheel_L_Joint" gear="1" joint="wheel_L_Joint" ctrlrange="-40 40" />
        <motor name="abad_R_Joint" gear="1" joint="abad_R_Joint" ctrlrange="-80 80" />
        <motor name="hip_R_Joint" gear="1" joint="hip_R_Joint" ctrlrange="-80 80" />
        <motor name="knee_R_Joint" gear="1" joint="knee_R_Joint" ctrlrange="-80 80" />
        <motor name="wheel_R_Joint" gear="1" joint="wheel_R_Joint" ctrlrange="-40 40" />
    </actuator>

    <keyframe>
        <!-- Balanced crouch: wheel-ground contact sits directly under the whole-body COM.
             Solved by FK/least-squares against the leg kinematics, not hand-tuned. -->
        <key name="home"
            qpos="0 0 0.72  1 0 0 0  0 0.40397 0.91652 0  0 -0.40397 -0.91652 0" />
    </keyframe>
</mujoco>
